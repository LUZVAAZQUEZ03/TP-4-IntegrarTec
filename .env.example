# PostgreSQL local (Docker Compose)
POSTGRES_USER=planify_user
POSTGRES_PASSWORD=planify_password
POSTGRES_DB=planify_db
POSTGRES_PORT=5432

# Prisma
DATABASE_URL="postgresql://planify_user:planify_password@localhost:5432/planify_db?schema=public"

# Server
PORT=3000

# JWT (use long random strings in production, min 32 chars)
JWT_SECRET=replace_with_a_long_random_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_another_long_random_secret_min_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# CORS
FRONTEND_URL=http://localhost:3001
