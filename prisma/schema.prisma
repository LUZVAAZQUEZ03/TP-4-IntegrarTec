generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN

  @@map("roles")
}

enum Priority {
  LOW
  MEDIUM
  HIGH

  @@map("priorities")
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED

  @@map("task_statuses")
}

enum ReminderType {
  AT_TIME
  FIVE_MINUTES
  FIFTEEN_MINUTES
  THIRTY_MINUTES
  ONE_HOUR
  ONE_DAY

  @@map("reminder_types")
}

enum Recurrence {
  NONE
  DAILY
  WEEKLY

  @@map("recurrences")
}

model User {
  id               String   @id @default(uuid())
  name             String
  email            String   @unique
  passwordHash     String
  refreshTokenHash String?
  avatar           String?
  role             Role     @default(USER)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tasks      Task[]
  categories Category[]
  reminders  Reminder[]

  @@map("users")
}

model Category {
  id        String   @id @default(uuid())
  name      String
  color     String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
  @@map("categories")
}

model Task {
  id             String     @id @default(uuid())
  title          String
  description    String?
  dueDate        DateTime?
  startTime      DateTime?
  endTime        DateTime?
  priority       Priority   @default(MEDIUM)
  status         TaskStatus @default(PENDING)
  categoryId     String?
  category       Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  isRecurring    Boolean    @default(false)
  recurrence     Recurrence @default(NONE)
  recurrenceDays Int[]      @default([])
  completedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  reminders Reminder[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, dueDate])
  @@map("tasks")
}

model Reminder {
  id        String       @id @default(uuid())
  taskId    String
  task      Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  remindAt  DateTime
  type      ReminderType @default(AT_TIME)
  isSent    Boolean      @default(false)
  sentAt    DateTime?
  createdAt DateTime     @default(now())

  @@index([userId])
  @@index([taskId])
  @@index([isSent, remindAt])
  @@map("reminders")
}
